    <bpmndi:BPMNShape id="liu_di" bpmnElement="copyToLiuQun"><dc:Bounds x="1060" y="130" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="zheng_di" bpmnElement="copyToZhengXiangfeng"><dc:Bounds x="1060" y="270" width="130" height="80"/></bpmndi:BPMNShape>
