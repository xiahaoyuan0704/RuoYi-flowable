    <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1190" y="310"/><di:waypoint x="1255" y="310"/><di:waypoint x="1255" y="265"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1280" y="240"/><di:waypoint x="1320" y="240"/></bpmndi:BPMNEdge>
