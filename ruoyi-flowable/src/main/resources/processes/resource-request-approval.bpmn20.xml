    <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="800" y="340"/><di:waypoint x="905" y="340"/><di:waypoint x="905" y="265"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="930" y="240"/><di:waypoint x="970" y="240"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="995" y="215"/><di:waypoint x="995" y="170"/><di:waypoint x="1060" y="170"/></bpmndi:BPMNEdge>
