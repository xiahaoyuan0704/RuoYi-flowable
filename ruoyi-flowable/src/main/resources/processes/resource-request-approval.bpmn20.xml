<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://ruoyi.vip/flowable">
  <process id="resourceRequestApproval" name="电网项目管理部提资流程审批表" isExecutable="true">
    <documentation>提资人提交并经技术部门负责人审批后，费控主任和项目经理并行办理；费控主任分支继续转经办人，两个分支完成后抄送刘群和郑向峰。</documentation>
    <startEvent id="start" name="开始"/>
    <userTask id="requesterSubmit" name="提资人" flowable:assignee="${initiator}" flowable:userType="assignee"/>
    <userTask id="technicalDepartmentLeader" name="技术部门负责人" flowable:assignee="${technicalDepartmentLeaderUserId}" flowable:userType="assignee"/>
    <parallelGateway id="approvalFork" name="并行办理"/>
    <userTask id="costControlDirector" name="费控主任" flowable:assignee="${costControlDirectorUserId}" flowable:userType="assignee"/>
    <userTask id="projectManager" name="项目经理" flowable:assignee="${projectManagerUserId}" flowable:userType="assignee"/>
    <userTask id="handler" name="转经办人" flowable:assignee="${handlerUserId}" flowable:userType="assignee"/>
    <parallelGateway id="approvalJoin" name="并行分支完成"/>
    <parallelGateway id="copyFork" name="并行抄送"/>
    <userTask id="copyToLiuQun" name="抄送刘群（阅知）" flowable:assignee="${liuQunUserId}" flowable:userType="assignee"/>
    <userTask id="copyToZhengXiangfeng" name="抄送郑向峰（阅知）" flowable:assignee="${zhengXiangfengUserId}" flowable:userType="assignee"/>
    <parallelGateway id="copyJoin"/>
    <endEvent id="end" name="结束"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="requesterSubmit"/>
    <sequenceFlow id="f2" sourceRef="requesterSubmit" targetRef="technicalDepartmentLeader"/>
    <sequenceFlow id="f3" sourceRef="technicalDepartmentLeader" targetRef="approvalFork"/>
    <sequenceFlow id="f4" sourceRef="approvalFork" targetRef="costControlDirector"/>
    <sequenceFlow id="f5" sourceRef="approvalFork" targetRef="projectManager"/>
    <sequenceFlow id="f6" sourceRef="costControlDirector" targetRef="handler"/>
    <sequenceFlow id="f7" sourceRef="handler" targetRef="approvalJoin"/>
    <sequenceFlow id="f8" sourceRef="projectManager" targetRef="approvalJoin"/>
    <sequenceFlow id="f9" sourceRef="approvalJoin" targetRef="copyFork"/>
    <sequenceFlow id="f10" sourceRef="copyFork" targetRef="copyToLiuQun"/>
    <sequenceFlow id="f11" sourceRef="copyFork" targetRef="copyToZhengXiangfeng"/>
    <sequenceFlow id="f12" sourceRef="copyToLiuQun" targetRef="copyJoin"/>
    <sequenceFlow id="f13" sourceRef="copyToZhengXiangfeng" targetRef="copyJoin"/>
    <sequenceFlow id="f14" sourceRef="copyJoin" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram_resource"><bpmndi:BPMNPlane id="plane_resource" bpmnElement="resourceRequestApproval">
    <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="80" y="222" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="requester_di" bpmnElement="requesterSubmit"><dc:Bounds x="150" y="200" width="100" height="80"/></bpmndi:BPMNShape>
