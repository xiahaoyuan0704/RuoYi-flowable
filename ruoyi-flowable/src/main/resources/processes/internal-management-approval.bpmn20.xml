<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://ruoyi.vip/flowable">
  <process id="internalManagementApproval" name="内部管理审批流程" isExecutable="true">
    <documentation>发起人提交后，由费控主任、项目经理和部门经理并行审批；三人全部完成后抄送刘群和郑向峰。</documentation>
    <startEvent id="start" name="开始"/>
    <userTask id="initiatorSubmit" name="发起人" flowable:assignee="${initiator}" flowable:userType="assignee"/>
    <parallelGateway id="approvalFork" name="并行审批"/>
    <userTask id="costControlDirector" name="费控主任" flowable:assignee="${costControlDirectorUserId}" flowable:userType="assignee"/>
    <userTask id="projectManager" name="项目经理" flowable:assignee="${projectManagerUserId}" flowable:userType="assignee"/>
    <userTask id="departmentManager" name="部门经理" flowable:assignee="${departmentManagerUserId}" flowable:userType="assignee"/>
    <parallelGateway id="approvalJoin" name="全部通过"/>
    <parallelGateway id="copyFork" name="并行抄送"/>
    <userTask id="copyToLiuQun" name="抄送刘群（阅知）" flowable:assignee="${liuQunUserId}" flowable:userType="assignee"/>
    <userTask id="copyToZhengXiangfeng" name="抄送郑向峰（阅知）" flowable:assignee="${zhengXiangfengUserId}" flowable:userType="assignee"/>
    <parallelGateway id="copyJoin"/>
    <endEvent id="end" name="结束"/>

    <sequenceFlow id="f1" sourceRef="start" targetRef="initiatorSubmit"/>
    <sequenceFlow id="f2" sourceRef="initiatorSubmit" targetRef="approvalFork"/>
    <sequenceFlow id="f3" sourceRef="approvalFork" targetRef="costControlDirector"/>
    <sequenceFlow id="f4" sourceRef="approvalFork" targetRef="projectManager"/>
    <sequenceFlow id="f5" sourceRef="approvalFork" targetRef="departmentManager"/>
    <sequenceFlow id="f6" sourceRef="costControlDirector" targetRef="approvalJoin"/>
    <sequenceFlow id="f7" sourceRef="projectManager" targetRef="approvalJoin"/>
    <sequenceFlow id="f8" sourceRef="departmentManager" targetRef="approvalJoin"/>
    <sequenceFlow id="f9" sourceRef="approvalJoin" targetRef="copyFork"/>
    <sequenceFlow id="f10" sourceRef="copyFork" targetRef="copyToLiuQun"/>
    <sequenceFlow id="f11" sourceRef="copyFork" targetRef="copyToZhengXiangfeng"/>
    <sequenceFlow id="f12" sourceRef="copyToLiuQun" targetRef="copyJoin"/>
    <sequenceFlow id="f13" sourceRef="copyToZhengXiangfeng" targetRef="copyJoin"/>
    <sequenceFlow id="f14" sourceRef="copyJoin" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram_internal">
    <bpmndi:BPMNPlane id="plane_internal" bpmnElement="internalManagementApproval">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="100" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="initiator_di" bpmnElement="initiatorSubmit"><dc:Bounds x="180" y="200" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="approvalFork"><dc:Bounds x="330" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cost_di" bpmnElement="costControlDirector"><dc:Bounds x="430" y="70" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="project_di" bpmnElement="projectManager"><dc:Bounds x="430" y="200" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dept_di" bpmnElement="departmentManager"><dc:Bounds x="430" y="330" width="110" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="approvalJoin"><dc:Bounds x="590" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="copyfork_di" bpmnElement="copyFork"><dc:Bounds x="690" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="liu_di" bpmnElement="copyToLiuQun"><dc:Bounds x="790" y="130" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="zheng_di" bpmnElement="copyToZhengXiangfeng"><dc:Bounds x="790" y="270" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="copyjoin_di" bpmnElement="copyJoin"><dc:Bounds x="970" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1070" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="136" y="240"/><di:waypoint x="180" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="280" y="240"/><di:waypoint x="330" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="355" y="215"/><di:waypoint x="355" y="110"/><di:waypoint x="430" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="380" y="240"/><di:waypoint x="430" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="355" y="265"/><di:waypoint x="355" y="370"/><di:waypoint x="430" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="540" y="110"/><di:waypoint x="615" y="110"/><di:waypoint x="615" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="540" y="240"/><di:waypoint x="590" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="540" y="370"/><di:waypoint x="615" y="370"/><di:waypoint x="615" y="265"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="640" y="240"/><di:waypoint x="690" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="715" y="215"/><di:waypoint x="715" y="170"/><di:waypoint x="790" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="715" y="265"/><di:waypoint x="715" y="310"/><di:waypoint x="790" y="310"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="920" y="170"/><di:waypoint x="995" y="170"/><di:waypoint x="995" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="920" y="310"/><di:waypoint x="995" y="310"/><di:waypoint x="995" y="265"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1020" y="240"/><di:waypoint x="1070" y="240"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
